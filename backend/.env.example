# Đổi tên file này thành .env rồi điền giá trị thật trước khi chạy

# Kết nối PostgreSQL — thay username/password/tên database cho đúng máy của bạn
DATABASE_URL=postgres://username:password@localhost:5432/elearning

# Chuỗi bí mật để ký JWT — đổi thành 1 chuỗi ngẫu nhiên, dài, khó đoán
JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-bi-mat-that-dai-va-ngau-nhien

# Cổng chạy backend
PORT=5000

# URL frontend — dùng để cấu hình CORS
CLIENT_URL=http://localhost:5173

# API key Anthropic (console.anthropic.com) — dùng cho tính năng giải thích
# từ điển chi tiết bằng AI. Để trống thì tính năng này tự tắt.
ANTHROPIC_API_KEY=
